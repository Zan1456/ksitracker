# Neon Postgres connection string (Dashboard → Connect → "Pooled connection")
# Example: postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Optional — only needed if you want the "Continue with Google" button to work.
# Leave empty to keep it visible but disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL of the app (used by Auth.js)
NEXTAUTH_URL=http://localhost:3000
